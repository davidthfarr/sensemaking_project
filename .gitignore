# Secrets
.env
*.key
*.pem
*.token
*.secrets

# Data artifacts (raw / processed / evaluated datasets)
# Use data/* (not data/) so negation rules below can re-include specific subdirs
data/*
*.parquet
*.csv

# Event timelines are committed as static inputs, not generated artifacts
!data/event_timelines
!data/event_timelines/*.csv

# Generated notebook outputs (tables, figures, annotation)
outputs/

# Jupyter
.ipynb_checkpoints/

# Python
__pycache__/
.venv/
*.egg-info/
